{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "bash ../scripts/cf-build.sh",
    "build:app": "tsc -b && vite build",
    "vendor:hands": "node scripts/roam-vendor-hands.mjs",
    "predev": "npm run vendor:hands",
    "prebuild:app": "npm run vendor:hands",
    "db:migrate:staging": "wrangler d1 migrations apply soon-hackathon-2026-db-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply soon-hackathon-2026-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply soon-hackathon-2026-db-local --local --env local",
    "db:reset:staging": "node ../scripts/reset-staging-d1.mjs",
    "secrets:push": "node ../scripts/cf-secrets.mjs push",
    "secrets:check": "node ../scripts/cf-secrets.mjs check",
    "lint": "oxlint --deny-warnings",
    "test": "npm run lint && tsc -b && vitest run --coverage && npm run test:runtime && knip && jscpd && node ../scripts/check-app-keys.mjs && node ../scripts/check-skill-actions.mjs",
    "test:checks": "node ../scripts/check-app-checks.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "bash ../scripts/cf-deploy.sh",
    "cf-typegen": "wrangler types",
    "test:runtime": "vitest run --config vitest.config.runtime.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@sparkjsdev/spark": "~2.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.180.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.1",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jscpd": "^5.3.3",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
